# Copy to .env on the server (next to docker-compose.yml) and fill in.
# Generate passwords with:  openssl rand -hex 24   (letters/digits only, so no URL escaping)

# Domain pointing at this server (A record -> the EC2 Elastic IP). Caddy gets a
# free HTTPS certificate for it automatically. Leave unset to serve plain HTTP on port 80.
# DOMAIN=play.example.com

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me
MONGO_APP_USER=playunite
MONGO_APP_PASSWORD=change-me-too
